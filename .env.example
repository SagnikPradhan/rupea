# Without DATABASE_URL, the server starts its own Postgres in RUPEA_STORAGE_FILES/postgres.
# DATABASE_URL="postgres://user:password@localhost:5432/rupea"
RUPEA_STORAGE_FILES="data"
RUPEA_MODELS_DIR="data/models"
RUPEA_MODELS_MODE="download"
# Threads per model run; defaults to a quarter of the cores.
# RUPEA_MODELS_THREADS="2"
# Jobs run at once; 0 for a server that only answers requests.
# RUPEA_JOBS_WORKERS="1"
# Replace the built-in lists; |-separated date-fns formats.
# RUPEA_LEDGER_DATE_FORMATS="yyyy-MM-dd|d MMM yyyy"
# RUPEA_LEDGER_TIME_FORMATS="HH:mm|h:mm a"
# The largest upload adapter-node accepts, several statements at once.
BODY_SIZE_LIMIT="64M"
RUPEA_ACCOUNTS_SIGNUP="closed"
RUPEA_LOG_LEVEL="info"
# Where the server listens.
# RUPEA_SERVER_HOST="127.0.0.1"
# RUPEA_SERVER_PORT="3001"
# Where the web app reaches the server; https past localhost.
# RUPEA_API_URL="http://127.0.0.1:3001/api"
