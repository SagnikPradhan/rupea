# Without DATABASE_URL, the server starts its own Postgres on RUPEE_DATA_DIR/postgres.
# DATABASE_URL="postgres://user:password@localhost:5432/rupee"
RUPEE_DATA_DIR="data"
RUPEE_MIGRATIONS_DIR="drizzle"
RUPEE_MODELS="download"
RUPEE_MODELS_DIR="data/models"
# Threads per model run; defaults to a quarter of the cores.
# RUPEE_MODEL_THREADS="2"
# Replace the built-in lists; |-separated date-fns formats.
# RUPEE_DATE_FORMATS="yyyy-MM-dd|d MMM yyyy"
# RUPEE_TIME_FORMATS="HH:mm|h:mm a"
RUPEE_LOG_LEVEL="info"
RUPEE_SIGNUP="closed"
