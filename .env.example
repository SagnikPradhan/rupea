# Without DATABASE_URL, the server starts its own Postgres in RUPEE_STORAGE_FILES/postgres.
# DATABASE_URL="postgres://user:password@localhost:5432/rupee"
RUPEE_STORAGE_FILES="data"
RUPEE_MODELS_DIR="data/models"
RUPEE_MODELS_MODE="download"
# Threads per model run; defaults to a quarter of the cores.
# RUPEE_MODELS_THREADS="2"
# Replace the built-in lists; |-separated date-fns formats.
# RUPEE_LEDGER_DATE_FORMATS="yyyy-MM-dd|d MMM yyyy"
# RUPEE_LEDGER_TIME_FORMATS="HH:mm|h:mm a"
RUPEE_ACCOUNTS_SIGNUP="closed"
RUPEE_LOG_LEVEL="info"
