{
	"name": "rupee",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''; lefthook install",
		"check": "svelte-kit sync && rm -rf .svelte-kit/.svelte-check && svelte-check --tsgo --tsconfig ./tsconfig.json",
		"check:ts6": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@testing-library/svelte": "5.4.2",
		"@testing-library/user-event": "14.6.7",
		"@tsconfig/strictest": "^2.0.8",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^26.0.0",
		"@types/pg": "8.23.1",
		"@typescript-eslint/utils": "8.71.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/coverage-v8": "5.0.3",
		"drizzle-kit": "0.31.11",
		"eslint": "10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-functional": "10.0.1",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.13.0",
		"happy-dom": "20.14.5",
		"lefthook": "2.1.16",
		"pino-pretty": "13.1.3",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "~6.0.2",
		"typescript-eslint": "8.71.0",
		"valibot": "1.5.0",
		"vite": "^8.3.0",
		"vitest": "5.0.3"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#services/*": "./src/lib/server/services/*",
		"#tests/*": "./tests/*"
	},
	"dependencies": {
		"@electric-sql/pglite": "0.5.8",
		"@electric-sql/pglite-pgvector": "0.0.9",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@fontsource-variable/noto-sans": "5.3.0",
		"@huggingface/tokenizers": "0.2.0",
		"@napi-rs/canvas": "1.0.10",
		"bits-ui": "2.19.5",
		"csv-parse": "7.0.3",
		"date-fns": "4.4.0",
		"drizzle-orm": "0.45.3",
		"neverthrow": "8.2.0",
		"onnxruntime-node": "1.30.0",
		"pdfjs-dist": "6.3.289",
		"pg": "8.23.1",
		"pino": "10.4.0",
		"read-excel-file": "9.3.10",
		"ts-pattern": "5.9.0",
		"uuid": "14.0.2",
		"yaml": "2.9.1"
	}
}
