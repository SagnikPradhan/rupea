{
	"name": "rupea",
	"private": true,
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''; lefthook install",
		"check": "svelte-kit sync && rm -rf .svelte-kit/.svelte-check && svelte-check --tsgo --tsconfig ./tsconfig.json && pnpm --filter site check",
		"site": "pnpm --filter site dev",
		"check:ts6": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"models": "tsx --env-file-if-exists=.env scripts/models.ts",
		"replay": "tsx --env-file-if-exists=.env scripts/replay.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"bench": "vitest bench --run --reporter=verbose --silent=false",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:coverage": "mcr -c mcr.config.ts -- playwright test"
	},
	"devDependencies": {
		"@cantoo/pdf-lib": "2.11.1",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/svelte": "5.4.2",
		"@testing-library/user-event": "14.6.8",
		"@tsconfig/strictest": "^2.0.8",
		"@tsconfig/svelte": "^5.0.8",
		"@types/emscripten": "1.41.6",
		"@types/node": "^26.6.5",
		"@types/pg": "8.23.1",
		"@typescript-eslint/utils": "8.72.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/coverage-v8": "5.0.5",
		"drizzle-kit": "0.31.11",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-functional": "10.0.1",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.13.0",
		"happy-dom": "21.0.4",
		"lefthook": "2.2.2",
		"monocart-coverage-reports": "3.1.0",
		"pino-pretty": "13.2.0",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^1.1.2",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tsx": "4.23.15",
		"typescript": "~6.0.2",
		"typescript-eslint": "8.72.1",
		"valibot": "1.5.0",
		"vite": "^8.3.5",
		"vitest": "5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#routes/*": "./src/routes/*",
		"#services/*": "./src/lib/server/services/*",
		"#tests/*": "./tests/*"
	},
	"dependencies": {
		"@codemirror/commands": "6.11.1",
		"@codemirror/language": "6.13.1",
		"@codemirror/search": "6.7.2",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.15",
		"@embedpdf/pdfium": "2.15.1",
		"@huggingface/tokenizers": "0.2.0",
		"@lezer/highlight": "1.2.5",
		"@rupea/theme": "workspace:*",
		"@tabler/icons-svelte-runes": "3.49.0",
		"@tanstack/svelte-virtual": "3.13.49",
		"bits-ui": "2.20.2",
		"chokidar": "6.0.0",
		"csv-parse": "7.0.3",
		"date-fns": "4.4.0",
		"drizzle-orm": "0.45.4",
		"kysely": "0.29.7",
		"neverthrow": "8.2.0",
		"officecrypto-tool": "0.0.19",
		"onnxruntime-node": "1.31.1",
		"pg": "8.23.1",
		"pino": "10.4.0",
		"portable-pg": "0.180601.0",
		"tinypool": "2.2.0",
		"ts-pattern": "5.9.2",
		"unique-names-generator": "4.7.1",
		"uplot": "1.6.32",
		"uuid": "14.0.3",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
		"yaml": "2.9.1"
	}
}
