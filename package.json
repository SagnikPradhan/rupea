{
	"name": "rupea",
	"private": true,
	"version": "0.0.1",
	"license": "AGPL-3.0-only",
	"type": "module",
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "run-p dev:server dev:web",
		"dev:web": "pnpm --filter @rupea/web dev",
		"dev:server": "pnpm build:server && run-p watch:server restart:server",
		"watch:server": "vite build --config packages/server/vite.config.ts --watch --emptyOutDir false --mode development",
		"restart:server": "NODE_ENV=development node --env-file-if-exists=.env --watch packages/server/dist/main.js",
		"build": "pnpm build:server && pnpm build:web",
		"build:web": "pnpm --filter @rupea/web build",
		"build:server": "vite build --config packages/server/vite.config.ts",
		"check:dist": "node packages/server/scripts/dependencies.ts",
		"start": "run-p start:server start:web",
		"start:server": "node --env-file-if-exists=.env packages/server/dist/main.js",
		"start:web": "pnpm --filter @rupea/web start",
		"preview": "pnpm --filter @rupea/web preview",
		"prepare": "lefthook install",
		"check": "pnpm check:root && pnpm check:packages && pnpm --filter @rupea/web check && pnpm --filter site check",
		"check:root": "node node_modules/@typescript/native/bin/tsc -p .",
		"check:packages": "node node_modules/@typescript/native/bin/tsc -p packages/shared && node node_modules/@typescript/native/bin/tsc -p packages/contract && node node_modules/@typescript/native/bin/tsc -p packages/server",
		"check:ts6": "pnpm --filter @rupea/web check:ts6",
		"site": "pnpm --filter site dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . && stylelint 'packages/web/src/**/*.svelte'",
		"lint:prose": "lint/prose.sh",
		"lint:fix": "eslint --fix . && stylelint --fix 'packages/web/src/**/*.svelte'",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"models": "tsx --env-file-if-exists=.env packages/server/scripts/models.ts",
		"seed": "tsx --env-file-if-exists=.env packages/server/scripts/seed.ts",
		"fixtures": "tsx --env-file-if-exists=.env packages/server/scripts/fixtures.ts",
		"replay": "tsx --env-file-if-exists=.env packages/server/scripts/replay.ts",
		"test": "vitest run && pnpm --filter @rupea/web test",
		"test:watch": "vitest",
		"bench": "vitest bench --run --reporter=verbose --silent=false",
		"test:coverage": "vitest run --coverage && pnpm --filter @rupea/web test:coverage",
		"test:e2e": "pnpm --filter @rupea/web test:e2e",
		"test:e2e:coverage": "pnpm --filter @rupea/web test:e2e:coverage"
	},
	"devDependencies": {
		"@cantoo/pdf-lib": "2.11.1",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@eslint/js": "10.0.1",
		"@faker-js/faker": "10.6.0",
		"@tsconfig/strictest": "^2.0.8",
		"@types/emscripten": "1.41.6",
		"@types/node": "^26.6.5",
		"@types/pg": "8.23.1",
		"@typescript-eslint/utils": "8.72.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/coverage-v8": "5.0.5",
		"drizzle-kit": "0.31.11",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-functional": "10.0.1",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.13.0",
		"lefthook": "2.2.2",
		"npm-run-all2": "9.0.4",
		"postcss-html": "2.0.0",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^1.1.2",
		"prettier-plugin-jsdoc": "1.8.1",
		"prettier-plugin-svelte": "^4.1.1",
		"stylelint": "17.16.0",
		"stylelint-config-standard": "40.0.0",
		"svelte": "^5.57.3",
		"tsx": "4.23.15",
		"typescript": "~6.0.2",
		"typescript-eslint": "8.72.1",
		"vite": "^8.3.5",
		"vitest": "5.0.5"
	}
}
