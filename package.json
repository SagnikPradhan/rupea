{
	"name": "rupea",
	"private": true,
	"version": "0.0.1",
	"license": "AGPL-3.0-only",
	"type": "module",
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "pnpm --parallel --filter @rupea/server --filter @rupea/web dev",
		"build": "pnpm --filter @rupea/server --filter @rupea/web build",
		"start": "pnpm --parallel --filter @rupea/server --filter @rupea/web start",
		"prepare": "lefthook install",
		"check": "node node_modules/@typescript/native/bin/tsc -p . && pnpm -r check",
		"test": "vitest run",
		"lint": "eslint . && stylelint 'packages/web/src/**/*.svelte'",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@eslint/js": "10.0.1",
		"@tsconfig/strictest": "^2.0.8",
		"@types/node": "^26.6.5",
		"@typescript-eslint/utils": "8.72.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/coverage-v8": "5.0.5",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-functional": "10.0.1",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.13.0",
		"lefthook": "2.2.2",
		"postcss-html": "2.0.0",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^1.1.2",
		"prettier-plugin-jsdoc": "1.8.1",
		"prettier-plugin-svelte": "^4.1.1",
		"stylelint": "17.16.0",
		"stylelint-config-standard": "40.0.0",
		"svelte": "^5.57.3",
		"typescript": "~6.0.2",
		"typescript-eslint": "8.72.1",
		"vitest": "5.0.5"
	}
}
