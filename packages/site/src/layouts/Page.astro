---
import '@rupea/theme/index.css';
import '../site.css';

type Props = { title: string; description: string };

const { title, description } = Astro.props;
const section = Astro.url.pathname.split('/')[1];

const links = [
	{ href: '/manual', label: 'Manual', current: section === 'manual' },
	{ href: '/brand', label: 'Brand', current: section === 'brand' },
	{ href: 'https://github.com/SagnikPradhan/rupea', label: 'GitHub', current: false },
];

const repository = 'https://github.com/SagnikPradhan/rupea';

const columns = [
	{
		title: 'Manual',
		links: [
			{ href: '/manual', label: 'Getting started' },
			{ href: '/manual/schemas', label: 'Writing schemas' },
			{ href: '/manual/glossary', label: 'Glossary' },
		],
	},
	{
		title: 'Project',
		links: [
			{ href: repository, label: 'GitHub' },
			{ href: `${repository}/issues`, label: 'Issues' },
			{ href: `${repository}/blob/master/LICENSE`, label: 'Licence' },
			{ href: '/brand', label: 'Brand' },
		],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title === 'Rupea' ? title : `${title} · Rupea`}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL('/brand/og.png', Astro.site)} />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
	</head>
	<body>
		<header class="bar">
			<div class="wide">
				<a class="plain brand" href="/">
					Rupea
				</a>
				<nav>
					{links.map((link) => (
						<a class="plain" href={link.href} aria-current={link.current ? 'page' : undefined}>
							{link.label}
						</a>
					))}
				</nav>
			</div>
		</header>
		<slot />
		<footer class="bar">
			<div class="wide">
				<div class="about">
					<span class="brand">Rupea</span>
					<p>A personal finance app for India, open source under the MIT licence.</p>
				</div>
				<div class="columns">
					{columns.map((column) => (
						<nav>
							<span class="label">{column.title}</span>
							{column.links.map((link) => (
								<a class="plain" href={link.href}>
									{link.label}
								</a>
							))}
						</nav>
					))}
				</div>
			</div>
		</footer>
	</body>
</html>
