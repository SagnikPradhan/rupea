---
import Page from '../layouts/Page.astro';

const points = [
	{
		title: 'Files you own',
		text: 'Your ledger is plain text in storage you choose. Rupea reads it and writes it, and never locks it away.',
	},
	{
		title: 'Every statement, one ledger',
		text: 'Upload PDFs and spreadsheets from banks, cards and brokers. Teach Rupea a layout once and every statement like it imports by itself.',
	},
	{
		title: 'Numbers first',
		text: 'Net worth, spending and returns on dense, quiet screens. What is at stake stands out; nothing else does.',
	},
];
---

<Page
	title="Rupea"
	description="Know where every rupee went. Every account, every statement, one ledger, in files you own."
>
	<main>
		<section class="wide hero">
			<span class="tag">Early preview</span>
			<h1>Know where every rupee went.</h1>
			<p>Every account, every statement, one ledger, in files you own.</p>
			<div class="actions">
				<a class="button primary" href="/manual">
					Read the manual
				</a>
				<a class="button" href="https://github.com/SagnikPradhan/rupea">
					GitHub
				</a>
			</div>
		</section>

		<section class="wide">
			<picture>
				<source media="(prefers-color-scheme: dark)" srcset="/screenshots/accounts-dark.png" />
				<img
					class="frame"
					src="/screenshots/accounts-light.png"
					alt="Net worth over six years, by account"
					width="2880"
					height="1800"
				/>
			</picture>
		</section>

		<section class="wide points">
			{points.map((point) => (
				<div>
					<h2>{point.title}</h2>
					<p>{point.text}</p>
				</div>
			))}
		</section>
	</main>
</Page>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--size-3);
		padding-block: var(--size-7) var(--size-6);
		text-align: center;
	}

	.hero h1 {
		max-width: 14em;
		margin: 0;
		font-size: var(--font-size-hero);
		letter-spacing: -0.025em;
	}

	.hero p {
		margin: 0;
		color: var(--color-muted);
		font-size: var(--font-size-2);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--size-2);
		padding-top: var(--size-1);
	}

	.points {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: var(--size-5);
		padding-block: var(--size-6) var(--size-7);
	}

	.points h2 {
		margin: 0 0 var(--size-1);
		font-weight: 500;
	}

	.points p {
		margin: 0;
		color: var(--color-muted);
	}

	/* The hero type shrinks with the screen, so the headline keeps to a few lines on a phone. */
	@media (width < 40rem) {
		.hero {
			padding-block: var(--size-6) var(--size-5);
		}

		.hero h1 {
			font-size: var(--font-size-display);
		}
	}
</style>
