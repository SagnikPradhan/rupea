---
import Screenshot from '../components/Screenshot.astro';
import Page from '../layouts/Page.astro';

const screens = [
	{
		name: 'Accounts',
		href: '/manual#accounts',
		text: 'net worth over time, and what each account cost and gained',
	},
	{
		name: 'Expenses',
		href: '/manual#expenses',
		text: 'spending by month and by account, against the period before',
	},
	{
		name: 'Transactions',
		href: '/manual#transactions',
		text: 'every transaction, with the file and line it came from',
	},
	{
		name: 'Files',
		href: '/manual#files',
		text: 'the ledger as plain text, to edit here or anywhere',
	},
	{
		name: 'Importing',
		href: '/manual#importing',
		text: 'bank, card and broker statements, PDF or spreadsheet, read into transactions',
	},
];
---

<Page
	title="Rupea"
	description="A personal finance app for India. Your money is a double-entry ledger in plain text files, and Rupea reads bank, card and broker statements into it."
>
	<main class="wide">
		<section class="intro">
			<h1>Rupea</h1>
			<p>
				A personal finance app for India. Your money is a double-entry ledger in plain text files,
				and Rupea reads bank, card and broker statements into it. It is open source under the MIT
				licence, and you can run it yourself.
			</p>
			<p class="status">Work in progress, not ready for use.</p>
			<div class="actions">
				<a class="button primary" href="/manual">
					Manual
				</a>
				<a class="button" href="https://github.com/SagnikPradhan/rupea">
					GitHub
				</a>
			</div>
		</section>

		<Screenshot name="accounts" alt="Net worth over six years, by account" />

		<section class="intro">
			<h2>What it does</h2>
			<ul>
				{screens.map((screen) => (
					<li>
						<a href={screen.href}>{screen.name}</a>: {screen.text}.
					</li>
				))}
			</ul>
		</section>
	</main>
</Page>

<style>
	main {
		padding-block: var(--size-2) var(--size-5);
	}

	.intro {
		max-width: var(--column);
		padding-bottom: var(--size-4);
	}

	.status {
		color: var(--color-muted);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--size-2);
		padding-top: var(--size-2);
	}
</style>
