---
import Screenshot from '../components/Screenshot.astro';
import Page from '../layouts/Page.astro';

const features = [
	{
		title: 'Your ledger is plain text',
		text: 'Every account and transaction is a line in a double-entry text file, in storage you choose. Edit the files in Rupea or in any editor, and every transaction on screen links back to the line it came from.',
		shot: 'files',
		alt: 'A ledger file, plain text you own',
	},
	{
		title: 'Statements become transactions',
		text: 'Upload a PDF or spreadsheet from a bank, card or broker. Describe its layout once in a schema, and every statement like it reads the same way, each row put in an account.',
		shot: 'import',
		alt: 'A bank statement read into transactions, each in an account',
	},
	{
		title: 'Spending by month',
		text: 'What you spent each month, split by account and set against the period before, so a change shows up as soon as it happens.',
		shot: 'expenses',
		alt: 'Spending by month over a year, by account',
	},
];
---

<Page
	title="Rupea"
	description="Know where every rupee went. A personal finance app for India: a double-entry ledger in plain text files, filled from your bank, card and broker statements."
>
	<main class="wide">
		<header>
			<span class="label">Open source · Work in progress</span>
			<h1>Know where every rupee went.</h1>
			<p>
				A personal finance app for India. Your money is a double-entry ledger in plain text files,
				and Rupea reads bank, card and broker statements into it.
			</p>
			<div class="actions">
				<a class="button primary" href="/manual">
					Read the manual
				</a>
				<a class="button" href="https://github.com/SagnikPradhan/rupea">
					GitHub
				</a>
			</div>
		</header>

		<Screenshot name="accounts" alt="Net worth over six years, by account" />

		<div class="features">
			{features.map((feature) => (
				<section>
					<Screenshot name={feature.shot} alt={feature.alt} />
					<h2>{feature.title}</h2>
					<p>{feature.text}</p>
				</section>
			))}
		</div>
	</main>
</Page>

<style>
	main {
		display: flex;
		flex-direction: column;
		gap: var(--gap-page);
		padding-block: var(--gap-page);
	}

	header {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: var(--column);
		margin-inline: auto;
		text-align: center;
	}

	header h1 {
		margin: var(--gap-related) 0;
	}

	header p {
		margin: 0;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--gap-related);
		padding-top: var(--gap-group);
	}

	.features {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
		gap: var(--gap-block) var(--gap-group);
	}

	.features h2 {
		margin-top: var(--gap-group);
	}
</style>
