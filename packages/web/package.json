{
	"name": "@rupea/web",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#routes/*": "./src/routes/*",
		"#tests/*": "./tests/*"
	},
	"scripts": {
		"dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
		"build": "vite build",
		"start": "node --env-file-if-exists=.env build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && rm -rf .svelte-kit/.svelte-check && svelte-check --tsgo --tsconfig ./tsconfig.json",
		"check:ts6": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"bench": "vitest bench --run --reporter=verbose --silent=false",
		"test:e2e": "playwright test",
		"test:e2e:coverage": "mcr -c mcr.config.ts -- playwright test"
	},
	"dependencies": {
		"@codemirror/commands": "6.11.1",
		"@codemirror/language": "6.13.1",
		"@codemirror/search": "6.7.2",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.15",
		"@lezer/highlight": "1.2.5",
		"@orpc/client": "1.16.2",
		"@orpc/openapi-client": "1.16.2",
		"@rupea/contract": "workspace:*",
		"@rupea/shared": "workspace:*",
		"@rupea/theme": "workspace:*",
		"@tabler/icons-svelte-runes": "3.49.0",
		"@tanstack/svelte-virtual": "3.13.49",
		"bits-ui": "2.20.2",
		"d3-sankey": "0.12.3",
		"d3-scale": "4.0.3",
		"d3-shape": "3.2.1",
		"ts-pattern": "5.9.2",
		"valibot": "1.5.0"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@rupea/server": "workspace:*",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/svelte": "5.4.2",
		"@testing-library/user-event": "14.6.8",
		"@tsconfig/strictest": "^2.0.8",
		"@tsconfig/svelte": "^5.0.8",
		"@types/d3-sankey": "0.12.5",
		"@types/d3-scale": "4.0.9",
		"@types/d3-shape": "3.2.0",
		"@types/node": "^26.6.5",
		"@typescript/native": "npm:typescript@^7.0.2",
		"happy-dom": "21.0.4",
		"monocart-coverage-reports": "3.1.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"typescript": "~6.0.2",
		"vite": "^8.3.5",
		"vitest": "5.0.5"
	}
}
