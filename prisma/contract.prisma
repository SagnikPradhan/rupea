// use prisma-8

// Every model carries a generated `id`, `createdAt` and `updatedAt`. Ids are
// UUIDv7: generated by the client, and they sort by creation time. Prisma 8
// spells these as field presets rather than attributes.

enum Role {
  owner
}

model User {
  id          id.uuidv7String()
  createdAt   temporal.createdAt() @map("created_at")
  updatedAt   temporal.updatedAt() @map("updated_at")
  email       String       @unique
  // The ledger the user is working in.
  ledgerId    String?      @map("ledger_id")
  ledger      Ledger?      @relation(fields: [ledgerId], references: [id])
  sessions    Session[]
  memberships Membership[]

  @@map("users")
}

model Session {
  id        id.uuidv7String()
  createdAt temporal.createdAt() @map("created_at")
  updatedAt temporal.updatedAt() @map("updated_at")
  // SHA-256 of the cookie token; the token itself is never stored.
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")

  @@map("sessions")
}

// The outstanding sign-in code for an email; requesting a new one replaces it.
model EmailCode {
  id        id.uuidv7String()
  createdAt temporal.createdAt() @map("created_at")
  updatedAt temporal.updatedAt() @map("updated_at")
  email     String   @unique
  // SHA-256 of the code.
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")

  @@map("email_codes")
}

model Ledger {
  id          id.uuidv7String()
  createdAt   temporal.createdAt() @map("created_at")
  updatedAt   temporal.updatedAt() @map("updated_at")
  name        String
  users       User[]
  memberships Membership[]
  files       LedgerFile[]

  @@map("ledgers")
}

model Membership {
  id        id.uuidv7String()
  createdAt temporal.createdAt() @map("created_at")
  updatedAt temporal.updatedAt() @map("updated_at")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerId  String   @map("ledger_id")
  ledger    Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  role      Role

  @@unique([userId, ledgerId])
  @@map("memberships")
}

// The ledger index: what the `.rupee` files in a ledger's storage parse to.
// The files are the source of truth; these tables are derived from them by
// sync and can always be rebuilt (see the ledger application layer).

model LedgerFile {
  id           id.uuidv7String()
  createdAt    temporal.createdAt() @map("created_at")
  updatedAt    temporal.updatedAt() @map("updated_at")
  ledgerId     String               @map("ledger_id")
  ledger       Ledger               @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  key          String
  // Storage version of the indexed content. Null when the file had parse
  // errors, so every sync parses it again and reports them.
  version      String?
  transactions Transaction[]

  @@unique([ledgerId, key])
  @@map("ledger_files")
}

model Transaction {
  id          id.uuidv7String()
  createdAt   temporal.createdAt() @map("created_at")
  updatedAt   temporal.updatedAt() @map("updated_at")
  fileId      String               @map("file_id")
  file        LedgerFile           @relation(fields: [fileId], references: [id], onDelete: Cascade)
  // Line of the header in the file.
  line        Int
  // ISO calendar date, `YYYY-MM-DD`; sorts as text.
  date        String
  // Wall-clock time, `HH:MM:SS`, if the header gives one.
  time        String?
  description String
  postings    Posting[]

  @@map("transactions")
}

model Posting {
  id            id.uuidv7String()
  createdAt     temporal.createdAt() @map("created_at")
  updatedAt     temporal.updatedAt() @map("updated_at")
  transactionId String               @map("transaction_id")
  transaction   Transaction          @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  // Order within the transaction.
  position      Int
  account       String
  // Signed millionths of a unit; a transaction's postings sum to zero.
  amount        BigInt

  @@map("postings")
}
