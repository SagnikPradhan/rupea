[
  {
    "id": "column.transactions.time",
    "label": "Add column time on transactions",
    "summary": "Adds column time on transactions",
    "operationClass": "additive",
    "target": {
      "id": "sqlite",
      "details": {
        "schema": "main",
        "objectType": "column",
        "name": "time",
        "table": "transactions"
      }
    },
    "precheck": [
      {
        "description": "ensure column \"time\" is missing",
        "sql": "SELECT COUNT(*) = 0 AS \"result\" FROM pragma_table_info(?) WHERE \"name\" = ?",
        "params": [
          "transactions",
          "time"
        ]
      }
    ],
    "execute": [
      {
        "description": "add column \"time\"",
        "sql": "ALTER TABLE \"transactions\" ADD COLUMN \"time\" TEXT"
      }
    ],
    "postcheck": [
      {
        "description": "verify column \"time\" exists",
        "sql": "SELECT COUNT(*) > 0 AS \"result\" FROM pragma_table_info(?) WHERE \"name\" = ?",
        "params": [
          "transactions",
          "time"
        ]
      }
    ]
  }
]