cabal-version: 3.14
name: rupee
version: 0.1.0.0
description: A personal finance management app
license: MIT
license-file: LICENSE
maintainer: contact.sagnikpradhan@gmail.com
author: Sagnik Pradhan
homepage: https://github.com/SagnikPradhan/rupee
build-type: Simple
extra-doc-files: CHANGELOG.md

common common-options
  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DeriveGeneric
    FlexibleContexts
    FlexibleInstances
    GADTs
    ImportQualifiedPost
    OverloadedLists
    OverloadedStrings
    TypeApplications
    TypeFamilies

library
  import: common-options

  ghc-options:
    -Wall
    -pgmc
    clang
    -pgml
    clang

  exposed-modules:
    Extraction.File
    Extraction.Pdf
    Extraction.Runtime
    Extraction.Schema
    Persistence.Parser
    Prediction.Prediction
    Shared.Config
    Shared.Error

  pkgconfig-depends: poppler-glib
  extra-libraries: poppler-glib
  c-sources: csrc/pdf_wrapper.c
  hs-source-dirs: src
  include-dirs: csrc
  includes: pdf_wrapper.h
  build-depends:
    aeson >=2.2 && <2.3,
    base >=4.21.2.0 && <4.22,
    bytestring >=0.12.2.0 && <0.13,
    c-storable-deriving >=0.1.3 && <0.2,
    cassava >=0.5.4.1 && <0.6,
    containers >=0.7 && <0.8,
    filepath >=1.5.4.0 && <1.6,
    lens >=5.3.6 && <5.4,
    pcre2 >=2.3.1 && <2.4,
    scientific >=0.3.8.1 && <0.4,
    statistics >=0.16.5.0 && <0.17,
    text >=2.1.4 && <2.2,
    time >=1.15 && <1.16,
    unordered-containers >=0.2.21 && <0.3,
    vector >=0.13.2.0 && <0.14,
    xls >=0.1.3 && <0.2,
    xlsx >=1.3.0 && <1.4,
    yaml >=0.11.11.2 && <0.12,

executable rupee
  import: common-options
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    base >=4.21.2.0 && <4.22,
    rupee,

test-suite rupee-test
  import: common-options

  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  other-modules:
    Extraction.PdfSpec
    Extraction.RuntimeSpec
    Persistence.ParserSpec

  default-extensions:
    ImportQualifiedPost
    OverloadedLists
    OverloadedStrings

  build-depends:
    base >=4.21.2.0 && <4.22,
    containers >=0.7 && <0.8,
    hspec >=2.11.17 && <2.12,
    hspec-discover >=2.11.17 && <2.12,
    rupee,
    text >=2.1.4 && <2.2,
    time >=1.15 && <1.16,
    unordered-containers >=0.2.21 && <0.3,
